# The decision model. Step 2 of the workbench sets this up; pick one.
#   Jev on TypeSafe:        TYPESAFE_API_KEY=apikey_...   (console.typesafe.ai/keys)
#   DiffusionGemma:         scripts/setup_gemma.sh writes TYPESAFE_BASE_URL here
#   Gemini Decisions:       JEV101_MODEL=gemini, with the GEMINI_API_KEY below
# TYPESAFE_API_KEY=apikey_...
# JEV101_MODEL=gemini

# The Gemini API key, from https://aistudio.google.com/apikey. Needed whichever
# decision model you pick: step 6 reads the spell card with Gemini Decisions
# and writes the tale with Gemini.
# GEMINI_API_KEY=...
