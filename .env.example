# The decision model. Pick one.
#   The Discriminative model on TypeSafe:              TYPESAFE_API_KEY=apikey_...   (console.typesafe.ai/keys)
#   DiffusionGemma on Cloud Run:  scripts/setup_gemma.sh writes TYPESAFE_BASE_URL here
#   Rehearsal (no model):         start with JEV101_REHEARSAL=1 instead
# TYPESAFE_API_KEY=apikey_...

# Gemini, for the spell-reading branch in step 6: Vertex AI in your project,
# with your gcloud credentials and no API key. ./setup_codelab.sh writes these.
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
