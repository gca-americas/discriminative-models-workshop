# The decision model. Pick one.
#   The Discriminative model on TypeSafe:              TYPESAFE_API_KEY=ts-...   (console.typesafe.ai/keys)
#   DiffusionGemma on Cloud Run:  scripts/setup_gemma.sh writes TYPESAFE_BASE_URL here
#   Rehearsal (no model):         start with JEV101_REHEARSAL=1 instead
# TYPESAFE_API_KEY=ts-...

# Gemini, for the spell-reading branch in step 6. Pick one.
#   AI Studio:  GOOGLE_API_KEY=...          (aistudio.google.com/apikey)
#   Vertex AI:  the three lines below, with gcloud signed in
# GOOGLE_API_KEY=...
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
